{
  "lexicon": 1,
  "id": "at.secretsky.post",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["text", "createdAt"],
        "properties": {
          "text": {
            "type": "string",
            "maxGraphemes": 500,
            "maxLength": 5000
          },
          "reply": {
            "type": "object",
            "required": ["parent"],
            "properties": {
              "parent": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
            }
          },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
