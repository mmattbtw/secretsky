{
  "name": "secretsky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=env/dev.env scripts/develop.ts",
    "dev:local": "bun --env-file=env/local.env scripts/develop.ts",
    "build": "bun run codegen:lex && vite build",
    "start": "bun scripts/serve.ts",
    "lint": "eslint src lib scripts",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test",
    "migrate": "bun scripts/migrate.ts",
    "publish-lexicons": "bun --env-file=env/local.env scripts/publish-lexicons.ts",
    "codegen:lex": "bun scripts/codegen-lex.mjs",
    "test": "bun test ./lib"
  },
  "dependencies": {
    "@atproto/common-web": "alpha",
    "@atproto/identity": "alpha",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/lex-client": "alpha",
    "@atproto/lex-data": "^0.1.7",
    "@atproto/lex-schema": "alpha",
    "@atproto/oauth-client-node": "alpha",
    "@atproto/oauth-scopes": "0.0.0-spaces-alpha-20260818163953",
    "@atproto/space": "alpha",
    "@atproto/syntax": "alpha",
    "@atproto/xrpc-server": "alpha",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "kysely": "^0.29.5",
    "kysely-bun-worker": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@atproto/lex": "alpha",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "destr": "^2.0.5",
    "eslint": "^9.0.0",
    "nitro": "^3.0.260311-beta",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.14"
  },
  "overrides": {
    "@atproto/lex-builder": "alpha",
    "@atproto/lex-client": "alpha",
    "@atproto/lex-document": "alpha",
    "@atproto/lex-installer": "alpha",
    "@atproto/lex-resolver": "alpha",
    "@atproto/lex-schema": "alpha"
  },
  "packageManager": "bun@1.2.15",
  "engines": {
    "bun": ">=1.2.15"
  },
  "patchedDependencies": {
    "@atproto-labs/fetch-node@0.3.7": "patches/@atproto-labs%2Ffetch-node@0.3.7.patch"
  }
}
